# Copy to `.env` for local development. `npm run dev` and `npm start` load it
# with Node's --env-file-if-exists. Existing environment variables win.
# Do not commit `.env`.

# Code default when HOST is unset is 0.0.0.0 so containers accept traffic.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=node-ai-plain-language-api
